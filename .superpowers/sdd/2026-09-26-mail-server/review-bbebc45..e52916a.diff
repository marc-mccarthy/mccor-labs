--- /dev/null
+++ b/infra/modules/mailserver/templates/setup.sh.tftpl
@@ -0,0 +1,173 @@
+#!/usr/bin/env bash
+# Builds the mail server on first boot. Terraform fills in the placeholders.
+# Re-runs safely: every step checks whether it already happened.
+set -euxo pipefail
+exec > >(tee /var/log/mail-setup.log) 2>&1
+
+DOMAIN="${domain}"
+FQDN="${fqdn}"
+REGION="${region}"
+RELAY_USER="${relay_user}"
+ALERT_EMAIL="${alert_email}"
+PARAM_PREFIX="${param_prefix}"
+MAILBOXES="${mailbox_names}"
+
+hostnamectl set-hostname "$FQDN"
+echo "127.0.1.1 $FQDN ${fqdn}" >> /etc/hosts
+
+export DEBIAN_FRONTEND=noninteractive
+apt-get update
+apt-get install -y ca-certificates curl gnupg unzip
+
+# ---------- tools ----------
+curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-aarch64.zip" -o /tmp/awscli.zip
+unzip -q /tmp/awscli.zip -d /tmp
+/tmp/aws/install
+
+# Debian cloud images ship no snapd, so the agent is installed from AWS's own
+# .deb. This is the only way onto the box -- there is no SSH port and no key --
+# so a failure here must stop the boot rather than be swallowed.
+curl -fsSL https://s3.amazonaws.com/ec2-downloads-windows/SSMAgent/latest/debian_arm64/amazon-ssm-agent.deb \
+  -o /tmp/amazon-ssm-agent.deb
+dpkg -i /tmp/amazon-ssm-agent.deb
+systemctl enable --now amazon-ssm-agent
+
+install -m 0755 -d /etc/apt/keyrings
+curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc
+chmod a+r /etc/apt/keyrings/docker.asc
+echo "deb [arch=arm64 signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/debian bookworm stable" \
+  > /etc/apt/sources.list.d/docker.list
+apt-get update
+apt-get install -y docker-ce docker-ce-cli containerd.io docker-compose-plugin
+systemctl enable --now docker
+
+# ---------- mail disk ----------
+# Nitro exposes a stable symlink per volume, so the disk is identified
+# exactly rather than guessed at by size. The old guess could select
+# nothing, letting mkdir succeed on the root volume and mail accumulate
+# somewhere that is never backed up.
+DEV="${mail_device}"
+for i in $(seq 1 12); do
+  [ -e "$DEV" ] && break
+  sleep 5
+done
+
+if [ ! -e "$DEV" ]; then
+  echo "FATAL: mail volume $DEV never appeared" >&2
+  exit 1
+fi
+
+# Only format a genuinely empty disk. A restored snapshot already has a
+# filesystem and must not be touched.
+blkid "$DEV" >/dev/null 2>&1 || mkfs.ext4 -L maildata "$DEV"
+
+mkdir -p /var/mail-data
+# Mount by LABEL, not by ID: a volume restored from a snapshot gets a new
+# volume ID but keeps its label.
+grep -q maildata /etc/fstab || echo "LABEL=maildata /var/mail-data ext4 defaults,nofail 0 2" >> /etc/fstab
+mount -a
+
+if ! mountpoint -q /var/mail-data; then
+  echo "FATAL: /var/mail-data did not mount" >&2
+  exit 1
+fi
+
+mkdir -p /var/mail-data/{mail-data,mail-state,mail-logs,config,letsencrypt}
+
+# ---------- TLS certificate ----------
+# Standalone mode binds port 80, which is why the security group opens it.
+apt-get install -y certbot
+if [ ! -d "/etc/letsencrypt/live/$FQDN" ]; then
+  for i in $(seq 1 20); do
+    certbot certonly --standalone --non-interactive --agree-tos \
+      -m "$ALERT_EMAIL" -d "$FQDN" && break
+    echo "certbot failed (DNS may not have propagated yet); retrying in 60s"
+    sleep 60
+  done
+fi
+
+# Renewal has to pause the mail server's port 80 listener; there isn't one,
+# but stopping the stack keeps certbot from colliding with anything later.
+cat > /etc/letsencrypt/renewal-hooks/deploy/reload-mail.sh <<'HOOK'
+#!/bin/sh
+docker restart mailserver 2>/dev/null || true
+HOOK
+chmod +x /etc/letsencrypt/renewal-hooks/deploy/reload-mail.sh
+
+# ---------- secrets ----------
+get_param() {
+  aws ssm get-parameter --region "$REGION" --name "$1" --with-decryption \
+    --query Parameter.Value --output text
+}
+
+RELAY_PASSWORD="$(get_param "$PARAM_PREFIX/_relay_password")"
+
+# ---------- the mail server ----------
+mkdir -p /opt/mail
+cd /opt/mail
+
+cat > compose.yaml <<COMPOSE
+services:
+  mailserver:
+    image: ghcr.io/docker-mailserver/docker-mailserver:latest
+    container_name: mailserver
+    hostname: $FQDN
+    restart: always
+    stop_grace_period: 1m
+    ports:
+      - "25:25"
+      - "465:465"
+      - "587:587"
+      - "993:993"
+    volumes:
+      - /var/mail-data/mail-data/:/var/mail/
+      - /var/mail-data/mail-state/:/var/mail-state/
+      - /var/mail-data/mail-logs/:/var/log/mail/
+      - /var/mail-data/config/:/tmp/docker-mailserver/
+      - /etc/letsencrypt:/etc/letsencrypt:ro
+      - /etc/localtime:/etc/localtime:ro
+    environment:
+      - SSL_TYPE=letsencrypt
+      - ENABLE_RSPAMD=1
+      - ENABLE_OPENDKIM=0
+      - ENABLE_OPENDMARC=0
+      - ENABLE_CLAMAV=0
+      - ENABLE_FAIL2BAN=1
+      - POSTMASTER_ADDRESS=${postmaster}
+      - RELAY_HOST=email-smtp.$REGION.amazonaws.com
+      - RELAY_PORT=587
+      - RELAY_USER=$RELAY_USER
+      - RELAY_PASSWORD=$RELAY_PASSWORD
+    cap_add:
+      - NET_ADMIN
+    healthcheck:
+      test: "ss --listening --tcp | grep -P 'LISTEN.+:smtp' || exit 1"
+      timeout: 3s
+      retries: 0
+COMPOSE
+
+docker compose up -d
+until docker exec mailserver ss --listening --tcp | grep -q smtp; do sleep 5; done
+
+# ---------- the people ----------
+# DKIM signing is left to SES, which signs on the way out, so there is no
+# key to generate here.
+for NAME in $MAILBOXES; do
+  ADDR="$NAME@$DOMAIN"
+  if docker exec mailserver setup email list 2>/dev/null | grep -q "^\* $ADDR"; then
+    continue
+  fi
+  PASS="$(get_param "$PARAM_PREFIX/$NAME")"
+  docker exec mailserver setup email add "$ADDR" "$PASS"
+done
+
+# postmaster@ and abuse@ are required by convention and receive the DMARC
+# reports. They go to a mailbox named on purpose in settings.auto.tfvars --
+# picking the first one alphabetically would silently move them when someone
+# is hired.
+for ALIAS in postmaster abuse; do
+  docker exec mailserver setup alias add "$ALIAS@$DOMAIN" "${admin_address}" || true
+done
+
+touch /var/lib/mail-setup-complete
+echo "mail server ready"
