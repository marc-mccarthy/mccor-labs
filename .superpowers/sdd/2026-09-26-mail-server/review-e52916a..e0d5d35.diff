+# Mailboxes are read from Parameter Store at run time rather than baked
+# into user-data. Templating them in would mean every new hire replaces
+# the instance, since user_data_replace_on_change is set.
+#
+# The heredoc delimiter is quoted ('SYNC') so bash writes its body
+# byte-for-byte: NAME, LOCAL, PASS, ADDR and the parameter-expansion on
+# NAME are left untouched for sync-accounts.sh to expand when IT runs, not
+# when this boot script writes the file. Only region, param_prefix and
+# domain are meant to be filled in here, by Terraform, at plan time -- the
+# parameter expansion is written with a doubled leading dollar sign so
+# Terraform's templatefile() treats it as literal text, not an expression.
+cat > /opt/mail/sync-accounts.sh <<'SYNC'
+#!/usr/bin/env bash
+# Creates any mailbox that exists in Parameter Store but not yet on this
+# server. Safe to re-run. Never deletes: removing someone is deliberate.
+set -euo pipefail
+
+aws ssm get-parameters-by-path --region ${region} --path ${param_prefix} \
+    --with-decryption --query 'Parameters[].[Name,Value]' --output text |
+while read -r NAME PASS; do
+  LOCAL="$${NAME##*/}"
+  # Names beginning with _ are not mailboxes (_relay_password).
+  case "$LOCAL" in _*) continue ;; esac
+  ADDR="$LOCAL@${domain}"
   if docker exec mailserver setup email list 2>/dev/null | grep -q "^\* $ADDR"; then
     continue
   fi
-  PASS="$(get_param "$PARAM_PREFIX/$NAME")"
+  echo "creating $ADDR"
   docker exec mailserver setup email add "$ADDR" "$PASS"
 done
+SYNC
+chmod +x /opt/mail/sync-accounts.sh
+/opt/mail/sync-accounts.sh
 
 # postmaster@ and abuse@ are required by convention and receive the DMARC
 # reports. They go to a mailbox named on purpose in settings.auto.tfvars --
 # picking the first one alphabetically would silently move them when someone
 # is hired.
 for ALIAS in postmaster abuse; do
   docker exec mailserver setup alias add "$ALIAS@$DOMAIN" "${admin_address}" || true
 done
 
 touch /var/lib/mail-setup-complete
