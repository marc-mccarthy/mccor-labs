+  --color-brand: #3d6bff;
+  /* Links, small text, button fill, focus rings — 5.31:1 on base. */
+  --color-accent: #527bff;
+
+  --color-glow-violet: #7c5cff;
+  --color-glow-cyan: #22d3ee;
+}
