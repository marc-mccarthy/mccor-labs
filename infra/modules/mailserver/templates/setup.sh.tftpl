#!/usr/bin/env bash
set -euxo pipefail
install -m 600 /dev/null /var/log/mail-setup.log
exec > >(tee /var/log/mail-setup.log) 2>&1

DOMAIN="${domain}"
FQDN="${fqdn}"
REGION="${region}"
RELAY_USER="${relay_user}"
ALERT_EMAIL="${alert_email}"
PARAM_PREFIX="${param_prefix}"

hostnamectl set-hostname "$FQDN"
echo "127.0.1.1 $FQDN ${fqdn}" >> /etc/hosts

export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y ca-certificates curl dnsutils gnupg unzip
apt-get install -y --no-install-recommends cron

apt-get install -y unattended-upgrades
cat > /etc/apt/apt.conf.d/20auto-upgrades <<'AUTO'
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";
AUTO

curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-aarch64.zip" -o /tmp/awscli.zip
unzip -q /tmp/awscli.zip -d /tmp
/tmp/aws/install

curl -fsSL https://s3.amazonaws.com/ec2-downloads-windows/SSMAgent/latest/debian_arm64/amazon-ssm-agent.deb \
  -o /tmp/amazon-ssm-agent.deb
dpkg -i /tmp/amazon-ssm-agent.deb
systemctl enable --now amazon-ssm-agent

install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc
chmod a+r /etc/apt/keyrings/docker.asc
echo "deb [arch=arm64 signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/debian bookworm stable" \
  > /etc/apt/sources.list.d/docker.list
apt-get update
apt-get install -y docker-ce docker-ce-cli containerd.io docker-compose-plugin
systemctl enable --now docker

DEV="${mail_device}"
for i in $(seq 1 12); do
  [ -e "$DEV" ] && break
  sleep 5
done

if [ ! -e "$DEV" ]; then
  echo "FATAL: mail volume $DEV never appeared" >&2
  exit 1
fi

blkid "$DEV" >/dev/null 2>&1 || mkfs.ext4 -L maildata "$DEV"

mkdir -p /var/mail-data
grep -q maildata /etc/fstab || echo "LABEL=maildata /var/mail-data ext4 defaults,nofail 0 2" >> /etc/fstab
mount -a

if ! mountpoint -q /var/mail-data; then
  echo "FATAL: /var/mail-data did not mount" >&2
  exit 1
fi

mkdir -p /var/mail-data/{mail-data,mail-state,mail-logs,config,letsencrypt}

if [ ! -f /swapfile ]; then
  fallocate -l 2G /swapfile
  chmod 600 /swapfile
  mkswap /swapfile
  echo "/swapfile none swap sw 0 0" >> /etc/fstab
fi
if ! swapon -a; then
  echo "WARNING: swapon failed -- the box is running without swap" >&2
fi

CERTBOT_DIR="/var/mail-data/letsencrypt"
apt-get install -y certbot

public_ipv4() {
  local token
  token="$(curl -sf -X PUT http://169.254.169.254/latest/api/token -H 'X-aws-ec2-metadata-token-ttl-seconds: 300')" || return 1
  curl -sf -H "X-aws-ec2-metadata-token: $token" http://169.254.169.254/latest/meta-data/public-ipv4
}

resolves_to_public_ip() {
  local ip answer resolver
  ip="$(public_ipv4)" || return 1
  [ -n "$ip" ] || return 1
  for resolver in 1.1.1.1 8.8.8.8; do
    answer="$(dig +short A "$FQDN" "@$resolver" 2>/dev/null)" || continue
    if printf '%s\n' "$answer" | grep -qxF "$ip"; then
      return 0
    fi
  done
  return 1
}

if [ ! -d "$CERTBOT_DIR/live/$FQDN" ]; then
  for i in $(seq 1 60); do
    resolves_to_public_ip && break
    echo "waiting for $FQDN to resolve to this instance's public IP before requesting a certificate"
    sleep 10
  done

  if ! resolves_to_public_ip; then
    echo "FATAL: $FQDN does not resolve to this instance's public IP; refusing to spend Let's Encrypt validation quota" >&2
    exit 1
  fi

  for i in 1 2 3; do
    certbot certonly --standalone --non-interactive --agree-tos \
      --config-dir "$CERTBOT_DIR" --work-dir "$CERTBOT_DIR/work" \
      --logs-dir "$CERTBOT_DIR/logs" \
      -m "$ALERT_EMAIL" -d "$FQDN" && break
    echo "certbot attempt $i failed; retrying in 60s"
    sleep 60
  done
fi

if [ ! -d "$CERTBOT_DIR/live/$FQDN" ]; then
  echo "FATAL: no certificate for $FQDN" >&2
  exit 1
fi

mkdir -p "$CERTBOT_DIR/renewal-hooks/deploy"
cat > "$CERTBOT_DIR/renewal-hooks/deploy/reload-mail.sh" <<'HOOK'
#!/bin/sh
docker restart mailserver 2>/dev/null || true
HOOK
chmod +x "$CERTBOT_DIR/renewal-hooks/deploy/reload-mail.sh"

mkdir -p /etc/systemd/system/certbot.service.d
cat > /etc/systemd/system/certbot.service.d/override.conf <<OVERRIDE
[Service]
ExecStart=
ExecStart=/usr/bin/certbot renew --config-dir $CERTBOT_DIR --work-dir $CERTBOT_DIR/work --logs-dir $CERTBOT_DIR/logs --quiet
OVERRIDE
systemctl daemon-reload

get_param() {
  aws ssm get-parameter --region "$REGION" --name "$1" --with-decryption \
    --query Parameter.Value --output text
}

{ set +x; } 2>/dev/null
RELAY_PASSWORD="$(get_param "$PARAM_PREFIX/_relay_password")"
set -x

mkdir -p /opt/mail
cd /opt/mail

cat > compose.yaml <<COMPOSE
services:
  mailserver:
    image: ghcr.io/docker-mailserver/docker-mailserver:16.0.1
    container_name: mailserver
    hostname: $FQDN
    restart: always
    stop_grace_period: 1m
    ports:
      - "25:25"
      - "587:587"
      - "993:993"
    volumes:
      - /var/mail-data/mail-data/:/var/mail/
      - /var/mail-data/mail-state/:/var/mail-state/
      - /var/mail-data/mail-logs/:/var/log/mail/
      - /var/mail-data/config/:/tmp/docker-mailserver/
      - /var/mail-data/letsencrypt:/etc/letsencrypt:ro
      - /etc/localtime:/etc/localtime:ro
    environment:
      - SSL_TYPE=letsencrypt
      - ENABLE_RSPAMD=1
      - ENABLE_OPENDKIM=0
      - ENABLE_OPENDMARC=0
      - ENABLE_CLAMAV=0
      - ENABLE_FAIL2BAN=1
      - ENABLE_RSPAMD_GREYLISTING=1
      - ENABLE_MANAGESIEVE=1
      - POSTMASTER_ADDRESS=${postmaster}
      - RELAY_HOST=email-smtp.$REGION.amazonaws.com
      - RELAY_PORT=587
      - RELAY_USER=$RELAY_USER
      - RELAY_PASSWORD=$RELAY_PASSWORD
    cap_add:
      - NET_ADMIN
    healthcheck:
      test: "ss --listening --tcp | grep -P 'LISTEN.+:smtp' || exit 1"
      timeout: 3s
      retries: 0
COMPOSE
chmod 600 compose.yaml

cat > /var/mail-data/config/fail2ban-jail.cf <<'JAIL'
[DEFAULT]
bantime  = 1h
findtime = 10m
maxretry = 5
JAIL

ACCOUNTS="/var/mail-data/config/postfix-accounts.cf"

cat > /opt/mail/sync-accounts.sh <<'SYNC'
#!/usr/bin/env bash
set -euo pipefail

ACCOUNTS="$${ACCOUNTS_FILE:-/var/mail-data/config/postfix-accounts.cf}"
touch "$ACCOUNTS"
chmod 600 "$ACCOUNTS"
SCRATCH="$(mktemp)"
trap 'rm -f "$SCRATCH"' EXIT
CHANGED=0
WANTED=""

has_account() {
  awk -F'|' -v addr="$1" '$1 == addr { found = 1 } END { exit !found }' "$ACCOUNTS"
}

stored_hash() {
  awk -F'|' -v addr="$1" '$1 == addr { print substr($0, length($1) + 2); exit }' "$ACCOUNTS"
}

drop_account() {
  awk -F'|' -v addr="$1" '$1 != addr' "$ACCOUNTS" > "$SCRATCH"
  cat "$SCRATCH" > "$ACCOUNTS"
}

add_account() {
  local hash
  hash="$(printf '%s' "$2" | openssl passwd -6 -stdin)"
  printf '%s|{SHA512-CRYPT}%s\n' "$1" "$hash" >> "$ACCOUNTS"
}

if ! PARAMS="$(aws ssm get-parameters-by-path --region ${region} --path ${param_prefix} \
                 --with-decryption --query 'Parameters[].[Name,Value]' --output text)"; then
  echo "FATAL: could not read mailbox passwords from SSM; accounts left unchanged" >&2
  exit 1
fi

while read -r NAME PASS; do
  [ -n "$NAME" ] || continue
  LOCAL="$${NAME##*/}"

  case "$LOCAL" in _*) continue ;; esac
  ADDR="$LOCAL@${domain}"
  WANTED="$WANTED $ADDR"

  if ! has_account "$ADDR"; then
    add_account "$ADDR" "$PASS"
    echo "added $ADDR"
    CHANGED=$((CHANGED + 1))
    continue
  fi

  STORED="$(stored_hash "$ADDR")"
  SALT="$(printf '%s' "$STORED" | cut -d'$' -f3)"
  CURRENT="{SHA512-CRYPT}$(printf '%s' "$PASS" | openssl passwd -6 -salt "$SALT" -stdin)"
  [ "$STORED" != "$CURRENT" ] || continue

  drop_account "$ADDR"
  add_account "$ADDR" "$PASS"
  echo "updated password for $ADDR"
  CHANGED=$((CHANGED + 1))
done <<< "$PARAMS"

if [ -z "$WANTED" ]; then
  echo "FATAL: SSM returned no mailboxes; refusing to remove any account" >&2
  exit 1
fi

EXISTING="$(awk -F'|' -v suffix="@${domain}" \
  'length($1) > length(suffix) && substr($1, length($1) - length(suffix) + 1) == suffix { print $1 }' "$ACCOUNTS")"

while read -r ADDR; do
  [ -n "$ADDR" ] || continue
  case " $WANTED " in *" $ADDR "*) continue ;; esac
  drop_account "$ADDR"
  echo "removed $ADDR"
  CHANGED=$((CHANGED + 1))
done <<< "$EXISTING"

if [ "$CHANGED" -gt 0 ] && docker ps --format '{{.Names}}' 2>/dev/null | grep -qx mailserver; then
  echo "reloading mailserver to pick up $CHANGED mailbox change(s)"
  docker restart mailserver >/dev/null
fi

echo "accounts file now has $(grep -c '|' "$ACCOUNTS" 2>/dev/null || echo 0) mailbox(es)"
SYNC
chmod +x /opt/mail/sync-accounts.sh
/opt/mail/sync-accounts.sh

if [ ! -s "$ACCOUNTS" ]; then
  echo "FATAL: no mailboxes were written to $ACCOUNTS -- the mail server would not start" >&2
  exit 1
fi

docker compose up -d

for i in $(seq 1 60); do
  docker exec mailserver ss --listening --tcp 2>/dev/null | grep -q smtp && break
  sleep 5
done

if ! docker exec mailserver ss --listening --tcp 2>/dev/null | grep -q smtp; then
  echo "FATAL: postfix is not listening on 25" >&2
  docker logs --tail 40 mailserver >&2 || true
  exit 1
fi

for ALIAS in postmaster abuse; do
  docker exec mailserver setup alias add "$ALIAS@$DOMAIN" "${admin_address}" || true
done

curl -fsSL https://amazoncloudwatch-agent.s3.amazonaws.com/debian/arm64/latest/amazon-cloudwatch-agent.deb \
  -o /tmp/cwagent.deb
dpkg -i /tmp/cwagent.deb

cat > /opt/aws/amazon-cloudwatch-agent/etc/config.json <<'CWCFG'
{
  "metrics": {
    "append_dimensions": { "InstanceId": "$${aws:InstanceId}" },
    "metrics_collected": {
      "disk": { "resources": ["/var/mail-data"], "measurement": ["disk_used_percent"], "metrics_collection_interval": 300, "aggregation_dimensions": [["InstanceId","path","fstype"]] },
      "mem":  { "measurement": ["mem_available_percent"], "metrics_collection_interval": 300 }
    }
  }
}
CWCFG

/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
  -a fetch-config -m ec2 -s -c file:/opt/aws/amazon-cloudwatch-agent/etc/config.json

cat > /etc/cron.daily/mail-health <<HEALTH
#!/bin/bash

PATH=/usr/local/bin:/usr/bin:/bin:/sbin:/usr/sbin
export PATH

TOPIC="${alerts_topic_arn}"
REGION="${region}"
alert() { aws sns publish --region "\$REGION" --topic-arn "\$TOPIC" --subject "mail: \$1" --message "\$2" || true; }

CERT=$CERTBOT_DIR/live/${fqdn}/cert.pem
if [ -f "\$CERT" ] && ! openssl x509 -checkend \$((21*86400)) -noout -in "\$CERT" >/dev/null; then
  alert "certificate expiring" "The TLS certificate for ${fqdn} expires within 21 days and has not renewed."
fi

QUEUED=\$(docker exec mailserver mailq 2>/dev/null | grep -c '^[A-F0-9]' || true)
QUEUED=\$(printf '%s' "\$QUEUED" | tr -dc '0-9')
if [ -z "\$QUEUED" ]; then QUEUED=0; fi

if [ "\$QUEUED" -gt 50 ]; then
  alert "mail queue backing up" "\$QUEUED messages are queued. The SES relay credential is the usual cause."
fi

if ! docker ps --format '{{.Names}}' 2>/dev/null | grep -qx mailserver; then
  alert "mail server not running" "The mailserver container is not running on \$(hostname)."
fi
HEALTH
chmod +x /etc/cron.daily/mail-health

cat > /etc/cron.hourly/mail-sync-accounts <<SYNCCRON
#!/bin/bash

PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
export PATH

/opt/mail/sync-accounts.sh
SYNCCRON
chmod +x /etc/cron.hourly/mail-sync-accounts

touch /var/lib/mail-setup-complete
echo "mail server ready"
