#!/usr/bin/env bash
# Builds the mail server on first boot. Terraform fills in the placeholders.
# Re-runs safely: every step checks whether it already happened.
set -euxo pipefail
exec > >(tee /var/log/mail-setup.log) 2>&1

DOMAIN="${domain}"
FQDN="${fqdn}"
REGION="${region}"
RELAY_USER="${relay_user}"
ALERT_EMAIL="${alert_email}"
PARAM_PREFIX="${param_prefix}"

hostnamectl set-hostname "$FQDN"
echo "127.0.1.1 $FQDN ${fqdn}" >> /etc/hosts

export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y ca-certificates curl gnupg unzip

# ---------- tools ----------
curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-aarch64.zip" -o /tmp/awscli.zip
unzip -q /tmp/awscli.zip -d /tmp
/tmp/aws/install

# Debian cloud images ship no snapd, so the agent is installed from AWS's own
# .deb. This is the only way onto the box -- there is no SSH port and no key --
# so a failure here must stop the boot rather than be swallowed.
curl -fsSL https://s3.amazonaws.com/ec2-downloads-windows/SSMAgent/latest/debian_arm64/amazon-ssm-agent.deb \
  -o /tmp/amazon-ssm-agent.deb
dpkg -i /tmp/amazon-ssm-agent.deb
systemctl enable --now amazon-ssm-agent

install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc
chmod a+r /etc/apt/keyrings/docker.asc
echo "deb [arch=arm64 signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/debian bookworm stable" \
  > /etc/apt/sources.list.d/docker.list
apt-get update
apt-get install -y docker-ce docker-ce-cli containerd.io docker-compose-plugin
systemctl enable --now docker

# ---------- mail disk ----------
# Nitro exposes a stable symlink per volume, so the disk is identified
# exactly rather than guessed at by size. The old guess could select
# nothing, letting mkdir succeed on the root volume and mail accumulate
# somewhere that is never backed up.
DEV="${mail_device}"
for i in $(seq 1 12); do
  [ -e "$DEV" ] && break
  sleep 5
done

if [ ! -e "$DEV" ]; then
  echo "FATAL: mail volume $DEV never appeared" >&2
  exit 1
fi

# Only format a genuinely empty disk. A restored snapshot already has a
# filesystem and must not be touched.
blkid "$DEV" >/dev/null 2>&1 || mkfs.ext4 -L maildata "$DEV"

mkdir -p /var/mail-data
# Mount by LABEL, not by ID: a volume restored from a snapshot gets a new
# volume ID but keeps its label.
grep -q maildata /etc/fstab || echo "LABEL=maildata /var/mail-data ext4 defaults,nofail 0 2" >> /etc/fstab
mount -a

if ! mountpoint -q /var/mail-data; then
  echo "FATAL: /var/mail-data did not mount" >&2
  exit 1
fi

mkdir -p /var/mail-data/{mail-data,mail-state,mail-logs,config,letsencrypt}

# ---------- swap ----------
# On the ROOT volume, deliberately: swap on the mail volume would be
# captured by every snapshot and put swap I/O in the backup path. DMS
# lists swap in its recommended setup; it turns a memory spike from an
# OOM kill into a slow moment.
if [ ! -f /swapfile ]; then
  fallocate -l 2G /swapfile
  chmod 600 /swapfile
  mkswap /swapfile
  echo "/swapfile none swap sw 0 0" >> /etc/fstab
fi
swapon -a || true

# ---------- TLS certificate ----------
# Standalone mode binds port 80, which is why the security group opens it.
#
# The ACME store lives on the persistent MAIL volume, not the root volume.
# Let's Encrypt allows 5 certificates per name set per week; with the store
# on the disposable root disk, a handful of instance replacements locks
# issuance for over a day. On the mail volume a rebuilt instance finds its
# existing certificate and issues nothing.
#
# certbot's defaults are not symlinked to this path: "apt-get install
# certbot" creates /etc/letsencrypt as a real directory first, so a later
# "ln -sfn ... /etc/letsencrypt" would land *inside* it rather than replace
# it, and certbot would keep writing to the root volume. Explicit
# --config-dir/--work-dir/--logs-dir flags are used everywhere instead, and
# reused by the renewal timer override below.
CERTBOT_DIR="/var/mail-data/letsencrypt"
apt-get install -y certbot

if [ ! -d "$CERTBOT_DIR/live/$FQDN" ]; then
  for i in $(seq 1 20); do
    certbot certonly --standalone --non-interactive --agree-tos \
      --config-dir "$CERTBOT_DIR" --work-dir "$CERTBOT_DIR/work" \
      --logs-dir "$CERTBOT_DIR/logs" \
      -m "$ALERT_EMAIL" -d "$FQDN" && break
    echo "certbot failed (DNS may not have propagated yet); retrying in 60s"
    sleep 60
  done
fi

if [ ! -d "$CERTBOT_DIR/live/$FQDN" ]; then
  echo "FATAL: no certificate for $FQDN" >&2
  exit 1
fi

# Renewal has to pause the mail server's port 80 listener; there isn't one,
# but stopping the stack keeps certbot from colliding with anything later.
mkdir -p "$CERTBOT_DIR/renewal-hooks/deploy"
cat > "$CERTBOT_DIR/renewal-hooks/deploy/reload-mail.sh" <<'HOOK'
#!/bin/sh
docker restart mailserver 2>/dev/null || true
HOOK
chmod +x "$CERTBOT_DIR/renewal-hooks/deploy/reload-mail.sh"

# Debian's certbot package ships a systemd timer that runs "certbot renew"
# against the default directories, so it would never find a certificate
# stored here and renewal would silently do nothing until the certificate
# expired -- Let's Encrypt stopped sending expiry-warning emails in June
# 2025, so there would be no signal until mail delivery broke. Override the
# packaged unit to pass the same non-default directories.
mkdir -p /etc/systemd/system/certbot.service.d
cat > /etc/systemd/system/certbot.service.d/override.conf <<OVERRIDE
[Service]
ExecStart=
ExecStart=/usr/bin/certbot renew --config-dir $CERTBOT_DIR --work-dir $CERTBOT_DIR/work --logs-dir $CERTBOT_DIR/logs --quiet
OVERRIDE
systemctl daemon-reload

# ---------- secrets ----------
get_param() {
  aws ssm get-parameter --region "$REGION" --name "$1" --with-decryption \
    --query Parameter.Value --output text
}

RELAY_PASSWORD="$(get_param "$PARAM_PREFIX/_relay_password")"

# ---------- the mail server ----------
mkdir -p /opt/mail
cd /opt/mail

cat > compose.yaml <<COMPOSE
services:
  mailserver:
    # Pinned deliberately. v16.0.0 moved Debian 12->13 and Dovecot
    # 2.3->2.4 with documented breaking changes; an unattended
    # docker compose pull would take mail down on an ordinary Tuesday.
    # Upgrades are a deliberate edit, after reading the release notes.
    image: ghcr.io/docker-mailserver/docker-mailserver:16.0.1
    container_name: mailserver
    hostname: $FQDN
    restart: always
    stop_grace_period: 1m
    ports:
      - "25:25"
      - "587:587"
      - "993:993"
    volumes:
      - /var/mail-data/mail-data/:/var/mail/
      - /var/mail-data/mail-state/:/var/mail-state/
      - /var/mail-data/mail-logs/:/var/log/mail/
      - /var/mail-data/config/:/tmp/docker-mailserver/
      - /var/mail-data/letsencrypt:/etc/letsencrypt:ro
      - /etc/localtime:/etc/localtime:ro
    environment:
      - SSL_TYPE=letsencrypt
      - ENABLE_RSPAMD=1
      - ENABLE_OPENDKIM=0
      - ENABLE_OPENDMARC=0
      - ENABLE_CLAMAV=0
      - ENABLE_FAIL2BAN=1
      # Greylisting rejects a first delivery attempt with a temporary
      # error. Real mail servers retry; most opportunistic spam bots do
      # not. Free, and the most effective single spam control here.
      - ENABLE_RSPAMD_GREYLISTING=1
      # Sieve rules live in Dovecot, in each user's home on the mail
      # volume, so they survive a restore without a separate backup.
      - ENABLE_MANAGESIEVE=1
      - POSTMASTER_ADDRESS=${postmaster}
      - RELAY_HOST=email-smtp.$REGION.amazonaws.com
      - RELAY_PORT=587
      - RELAY_USER=$RELAY_USER
      - RELAY_PASSWORD=$RELAY_PASSWORD
    cap_add:
      - NET_ADMIN
    healthcheck:
      test: "ss --listening --tcp | grep -P 'LISTEN.+:smtp' || exit 1"
      timeout: 3s
      retries: 0
COMPOSE

docker compose up -d
until docker exec mailserver ss --listening --tcp | grep -q smtp; do sleep 5; done

# ---------- the people ----------
# Mailboxes are read from Parameter Store at run time rather than baked
# into user-data. Templating them in would mean every new hire replaces
# the instance, since user_data_replace_on_change is set.
#
# The heredoc delimiter is quoted ('SYNC') so bash writes its body
# byte-for-byte: NAME, LOCAL, PASS, ADDR and the parameter-expansion on
# NAME are left untouched for sync-accounts.sh to expand when IT runs, not
# when this boot script writes the file. Only region, param_prefix and
# domain are meant to be filled in here, by Terraform, at plan time -- the
# parameter expansion is written with a doubled leading dollar sign so
# Terraform's templatefile() treats it as literal text, not an expression.
cat > /opt/mail/sync-accounts.sh <<'SYNC'
#!/usr/bin/env bash
# Creates any mailbox that exists in Parameter Store but not yet on this
# server. Safe to re-run. Never deletes: removing someone is deliberate.
set -euo pipefail

aws ssm get-parameters-by-path --region ${region} --path ${param_prefix} \
    --with-decryption --query 'Parameters[].[Name,Value]' --output text |
while read -r NAME PASS; do
  LOCAL="$${NAME##*/}"
  # Names beginning with _ are not mailboxes (_relay_password).
  case "$LOCAL" in _*) continue ;; esac
  ADDR="$LOCAL@${domain}"
  if docker exec mailserver setup email list 2>/dev/null | grep -q "^\* $ADDR"; then
    continue
  fi
  echo "creating $ADDR"
  docker exec mailserver setup email add "$ADDR" "$PASS"
done
SYNC
chmod +x /opt/mail/sync-accounts.sh
/opt/mail/sync-accounts.sh

# postmaster@ and abuse@ are required by convention and receive the DMARC
# reports. They go to a mailbox named on purpose in settings.auto.tfvars --
# picking the first one alphabetically would silently move them when someone
# is hired.
for ALIAS in postmaster abuse; do
  docker exec mailserver setup alias add "$ALIAS@$DOMAIN" "${admin_address}" || true
done

# ---------- monitoring ----------
# Two custom metrics, both inside the CloudWatch free tier.
curl -fsSL https://amazoncloudwatch-agent.s3.amazonaws.com/debian/arm64/latest/amazon-cloudwatch-agent.deb \
  -o /tmp/cwagent.deb
dpkg -i /tmp/cwagent.deb

cat > /opt/aws/amazon-cloudwatch-agent/etc/config.json <<'CWCFG'
{
  "metrics": {
    "append_dimensions": { "InstanceId": "$${aws:InstanceId}" },
    "metrics_collected": {
      "disk": { "resources": ["/var/mail-data"], "measurement": ["disk_used_percent"], "metrics_collection_interval": 300 },
      "mem":  { "measurement": ["mem_available_percent"], "metrics_collection_interval": 300 }
    }
  }
}
CWCFG

/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
  -a fetch-config -m ec2 -s -c file:/opt/aws/amazon-cloudwatch-agent/etc/config.json

# Two things CloudWatch cannot see. Let's Encrypt stopped sending expiry
# warnings in June 2025, so an unnoticed renewal failure becomes a client
# TLS error; and a queue backing up is usually a broken SES credential,
# which nothing else detects.
cat > /etc/cron.daily/mail-health <<HEALTH
#!/bin/bash
TOPIC="${alerts_topic_arn}"
REGION="${region}"
alert() { aws sns publish --region "\$REGION" --topic-arn "\$TOPIC" --subject "mail: \$1" --message "\$2" || true; }

CERT=$CERTBOT_DIR/live/${fqdn}/cert.pem
if [ -f "\$CERT" ] && ! openssl x509 -checkend \$((21*86400)) -noout -in "\$CERT" >/dev/null; then
  alert "certificate expiring" "The TLS certificate for ${fqdn} expires within 21 days and has not renewed."
fi

QUEUED=\$(docker exec mailserver mailq 2>/dev/null | grep -c '^[A-F0-9]' || echo 0)
if [ "\$QUEUED" -gt 50 ]; then
  alert "mail queue backing up" "\$QUEUED messages are queued. The SES relay credential is the usual cause."
fi
HEALTH
chmod +x /etc/cron.daily/mail-health

touch /var/lib/mail-setup-complete
echo "mail server ready"
