# ---------------------------------------------------------------
# Copy this to settings.auto.tfvars and fill in the blanks.
#
#   cp settings.auto.tfvars.example settings.auto.tfvars
#
# This file IS committed. settings.auto.tfvars is NOT -- it holds
# your real domain, your email address and your team's names.
#
# Values left as "" below are the ones you must fill in. Terraform
# refuses to run until they are set, rather than silently deploying
# with a placeholder.
# ---------------------------------------------------------------

# ---------- Fill these in ----------

# The domain you own. No "www", no "https://".
domain_name = ""

# Where AWS spending alerts and mail-server warnings are sent. Use an
# address on a DIFFERENT provider -- if this server breaks, an alert
# delivered to this server is an alert you never see.
alert_email = ""

# ---------- Safe defaults, change if you like ----------

# Short name for the app itself, used in per-environment resource names
# (website bucket, Cognito pool, DynamoDB table, Lambda). Deliberately
# separate from domain_name: domains change -- rebrands, .com to .io, a
# second domain -- and if resource names derived from the domain, changing
# it would REPLACE the DynamoDB table and the Cognito user pool, taking the
# data and every user account with them. Keeping them separate means a
# domain change touches only DNS, the certificate and CloudFront.
#
# DO NOT CHANGE THIS AFTER THE WEBSITE IS DEPLOYED. It renames every app
# resource, and a rename is a replace.
#
# 3-20 characters: lowercase letters, numbers, dashes. Cannot contain "aws",
# "amazon" or "cognito" -- Cognito domain prefixes reject those words.
project = "yourproject"

# Email an alert if the month's AWS bill is forecast to pass this (USD).
# The mail server costs ~$21/month, so 25 leaves room for a real
# mistake to show up without nagging about normal operation.
monthly_budget_usd = 25

# ---------------------------------------------------------------
# Your own mail server
#
# One EC2 instance holding your own mailboxes on a disk you own.
# Flat cost -- adding people does not add to the bill.
#
# Turn this on only AFTER the name servers from `deploy.sh setup` are
# live at your registrar. The server's TLS certificate is issued by
# reading DNS, which cannot work before the zone is authoritative.
# ---------------------------------------------------------------

enable_mailserver = false

# Who gets a mailbox. Local part => display name, so
# "jdoe" becomes jdoe@<domain_name>, shown as "Jane Doe".
mailboxes = {
  # jdoe = "Jane Doe"
}

# Which mailbox receives postmaster@, abuse@ and the DMARC reports.
# Name one deliberately -- left unset it would fall to whoever sorts
# first alphabetically, and would move when you hire someone.
admin_mailbox = ""

# Instance size. Default is the smallest that runs the full stack
# comfortably -- docker-mailserver's own documented recommendation is
# 2GB with swap, which is exactly what t4g.small is.
#
#   t4g.micro   1GB  ~$6.13/mo   TOO SMALL -- below the documented floor
#                                with Rspamd running. Risks the kernel
#                                OOM-killing the spam filter, which fails
#                                open and quietly stops filtering.
#   t4g.small   2GB  ~$12.26/mo  DEFAULT. Tight but correct.
#   t4g.medium  4GB  ~$24.53/mo  Headroom. Worth it if you add webmail,
#                                or if the memory alarm keeps firing.
#
# Decision rule, not a guess: if the mail-memory alarm fires more than
# twice in thirty days, move up one size and apply. Do not pre-buy it --
# the alarm costs nothing and tells you when you actually need it.
instance_type = "t4g.small"

# Size of the disk holding mail, in GB. Growing it is two steps: change
# this and apply, then run `sudo resize2fs /dev/<device>` on the box --
# Terraform grows the volume but cannot grow the filesystem on it.
# 20GB is roughly a decade of mail for five people with normal attachments.
mail_volume_gb = 20

# ---------------------------------------------------------------
# Mail forwarding (alternative to the mail server above -- you cannot
# have both, they each need the domain's MX record).
#
# Addresses that forward into an inbox you already own. No per-user
# cost and nothing to sign into.
# ---------------------------------------------------------------

# enable_email    = true
# mail_forward_to = ""                     # defaults to alert_email
# mail_recipients = ["hello", "support"]   # [] accepts the whole domain
