var PRIMARY_HOST = ${jsonencode(primary_host)};

function handler(event) {
  var request = event.request;
  var host = request.headers.host ? request.headers.host.value.toLowerCase() : '';
  var uri = request.uri;
  var clean = uri.endsWith('/index.html') ? uri.slice(0, -'index.html'.length) : uri;

  if (PRIMARY_HOST && host !== PRIMARY_HOST) {
    return redirect(needsSlash(clean) ? clean + '/' : clean, request);
  }

  if (clean !== uri) {
    return redirect(clean, request);
  }

  if (uri.endsWith('/')) {
    request.uri = uri + 'index.html';
    return request;
  }

  if (needsSlash(uri)) {
    return redirect(uri + '/', request);
  }

  return request;
}

function needsSlash(uri) {
  return !uri.endsWith('/') && !uri.split('/').pop().includes('.');
}

function redirect(path, request) {
  var qs = request.rawQueryString();
  return {
    statusCode: 301,
    statusDescription: 'Moved Permanently',
    headers: {
      location: { value: 'https://' + (PRIMARY_HOST || request.headers.host.value.toLowerCase()) + path + (qs ? '?' + qs : '') }
    }
  };
}
