+}
diff --git a/infra/modules/email/src/index.mjs b/infra/modules/email/src/index.mjs
new file mode 100644
index 0000000..7a1a45a
--- /dev/null
+++ b/infra/modules/email/src/index.mjs
@@ -0,0 +1,102 @@
+// Forwards mail that SES received on your domain to a real inbox.
+//
+// SES has already stored the raw message in S3 by the time this runs. We can't
+// re-send it untouched: SES only sends as a domain it has verified, so a
+// message still claiming "From: stranger@gmail.com" would be rejected. Instead
+// we swap From for our own address and put the original sender in Reply-To, so
+// replying from your inbox reaches the person who wrote to you.
+
+import { S3Client, GetObjectCommand } from "@aws-sdk/client-s3";
+import { SESClient, SendRawEmailCommand } from "@aws-sdk/client-ses";
+
+const s3 = new S3Client({});
+const ses = new SESClient({});
+
+const { MAIL_BUCKET, MAIL_FROM, FORWARD_TO } = process.env;
+
+// Headers that describe the original delivery. Left in place they contradict
+// the message we are about to send, and receivers treat that as forgery.
+const STRIP = new Set([
+  "return-path",
+  "sender",
+  "dkim-signature",
+  "domainkey-signature",
+  "authentication-results",
+  "received-spf",
+  "arc-authentication-results",
+  "arc-message-signature",
+  "arc-seal",
+]);
+
+// A header can be wrapped over several lines, with continuations indented.
+// Join them back up so each entry is one complete header.
+function splitMessage(raw) {
+  const blank = raw.search(/\r?\n\r?\n/);
+  if (blank === -1) return { headers: [], body: raw };
+
+  const headerBlock = raw.slice(0, blank);
+  const body = raw.slice(blank).replace(/^\r?\n\r?\n/, "");
+
+  const headers = [];
+  for (const line of headerBlock.split(/\r?\n/)) {
+    if (/^[ \t]/.test(line) && headers.length > 0) {
+      headers[headers.length - 1] += "\r\n" + line;
+    } else {
+      headers.push(line);
+    }
+  }
+  return { headers, body };
+}
+
+function valueOf(headers, name) {
+  const prefix = name.toLowerCase() + ":";
+  const found = headers.find((h) => h.toLowerCase().startsWith(prefix));
+  return found ? found.slice(prefix.length).trim() : null;
+}
+
+function rewrite(raw) {
+  const { headers, body } = splitMessage(raw);
+  const originalFrom = valueOf(headers, "from");
+
+  const kept = headers.filter((h) => {
+    const name = h.slice(0, h.indexOf(":")).toLowerCase();
+    return !STRIP.has(name) && name !== "from" && name !== "reply-to";
+  });
+
+  kept.unshift(`From: ${MAIL_FROM}`);
+  if (originalFrom) kept.push(`Reply-To: ${originalFrom}`);
+
+  return kept.join("\r\n") + "\r\n\r\n" + body;
+}
+
+export const handler = async (event) => {
+  const record = event.Records?.[0]?.ses;
+  if (!record) throw new Error("not an SES event");
+
+  // SES names the object after the message id, and refuses the message itself
+  // if its own spam or virus scan failed.
+  const key = record.mail.messageId;
+  const verdicts = record.receipt ?? {};
+  const failed = ["spamVerdict", "virusVerdict"].filter(
+    (v) => verdicts[v]?.status === "FAIL"
+  );
+  if (failed.length > 0) {
+    console.log(`dropped ${key}: ${failed.join(", ")}`);
+    return;
+  }
+
+  const stored = await s3.send(
+    new GetObjectCommand({ Bucket: MAIL_BUCKET, Key: key })
+  );
+  const raw = await stored.Body.transformToString();
+
+  await ses.send(
+    new SendRawEmailCommand({
+      Source: MAIL_FROM,
+      Destinations: [FORWARD_TO],
+      RawMessage: { Data: Buffer.from(rewrite(raw)) },
+    })
+  );
+
+  console.log(`forwarded ${key} to ${FORWARD_TO}`);
+};
diff --git a/infra/modules/email/variables.tf b/infra/modules/email/variables.tf
new file mode 100644
index 0000000..c35e06b
--- /dev/null
+++ b/infra/modules/email/variables.tf
@@ -0,0 +1,43 @@
+variable "domain_name" {
+  description = "Domain that receives mail, e.g. example.com"
+  type        = string
+}
+
+variable "zone_id" {
+  description = "Route 53 zone for domain_name"
+  type        = string
+}
+
+variable "forward_to" {
+  description = "Inbox that every address forwards to, e.g. you@gmail.com"
+  type        = string
+}
+
+variable "recipients" {
+  description = "Local parts that accept mail. Anything else is rejected. Use [] to accept the whole domain (catch-all)."
+  type        = list(string)
+  default     = ["hello", "support"]
+}
+
+variable "mail_from_local" {
+  description = "Local part the forwarder sends as. SES can only send as your own domain, so the original sender goes in Reply-To."
+  type        = string
+  default     = "noreply"
+}
+
+variable "retain_days" {
+  description = "How long raw messages stay in S3 before deletion"
+  type        = number
+  default     = 30
+}
+
+variable "log_retention_days" {
+  type    = number
+  default = 14
+}
+
+variable "force_destroy" {
+  description = "Allow deleting the mail bucket while it still holds messages"
+  type        = bool
+  default     = false
+}
diff --git a/infra/modules/mailserver/main.tf b/infra/modules/mailserver/main.tf
new file mode 100644
index 0000000..943721f
--- /dev/null
+++ b/infra/modules/mailserver/main.tf
@@ -0,0 +1,458 @@
+# Your own mail server, on your own instance, holding your own mailboxes.
+#
+# Receiving is direct: the internet delivers to this box on port 25, it runs
+# the spam filter, and it stores mail on a disk you own. Nobody else holds
+# the mailboxes.
+#
+# Sending goes out through SES on port 587 instead of straight to the world on
+# port 25. Two reasons, both practical: AWS blocks outbound 25 on every EC2
+# instance until you petition them to unblock it, and a brand-new IP address
+# has no sending reputation, so Gmail and Outlook treat its mail as suspicious.
+# Relaying through SES avoids both. SES is in your own account -- this is not a
+# third party holding your mail, only the last hop that hands it over.
+
+terraform {
+  required_providers {
+    aws = {
+      source  = "hashicorp/aws"
+      version = ">= 6.0"
+    }
+    random = {
+      source  = "hashicorp/random"
+      version = ">= 3.6"
+    }
+  }
+}
+
+data "aws_region" "current" {}
+data "aws_availability_zones" "available" {
+  state = "available"
+}
+
+locals {
+  fqdn      = "${var.hostname}.${var.domain_name}"
+  addresses = { for k, v in var.mailboxes : k => "${k}@${var.domain_name}" }
+
+  # Tag shared between the mail volume and the DLM policy that snapshots it,
+  # and surfaced as an output so a restore knows what to search for.
+  snapshot_tag = "${replace(var.domain_name, ".", "-")}-mail"
+}
+
+# ---------- Sending: SES as the outbound relay ----------
+
+resource "aws_ses_domain_identity" "main" {
+  domain = var.domain_name
+}
+
+resource "aws_ses_domain_dkim" "main" {
+  domain = aws_ses_domain_identity.main.domain
+}
+
+# Lets receiving servers verify the signature SES puts on your outgoing mail.
+resource "aws_route53_record" "dkim" {
+  count = 3
+
+  zone_id = var.zone_id
+  name    = "${aws_ses_domain_dkim.main.dkim_tokens[count.index]}._domainkey.${var.domain_name}"
+  type    = "CNAME"
+  ttl     = 600
+  records = ["${aws_ses_domain_dkim.main.dkim_tokens[count.index]}.dkim.amazonses.com"]
+}
+
+# An IAM user whose only power is handing mail to SES. Its access key doubles
+# as an SMTP password through a documented conversion, which is why the server
+# can authenticate to SES with plain SMTP.
+resource "aws_iam_user" "smtp" {
+  name = "${replace(var.domain_name, ".", "-")}-mail-relay"
+}
+
+data "aws_iam_policy_document" "smtp" {
+  statement {
+    # Scoped to this one identity, matching modules/email. This key is
+    # long-lived and lives on an internet-facing box, so it gets the
+    # smallest blast radius available. Broader than modules/email's single
+    # ses:FromAddress condition, deliberately: this relay sends as every
+    # mailbox on the domain, and a fixed FromAddress would break on every
+    # new hire, so the identity ARN is the narrowest scope that still works.
+    actions   = ["ses:SendRawEmail"]
+    resources = [aws_ses_domain_identity.main.arn]
+  }
+}
+
+resource "aws_iam_user_policy" "smtp" {
+  name   = "send-mail"
+  user   = aws_iam_user.smtp.name
+  policy = data.aws_iam_policy_document.smtp.json
+}
+
+resource "aws_iam_access_key" "smtp" {
+  user = aws_iam_user.smtp.name
+}
+
+# ---------- The mailboxes themselves ----------
+
+# One password per person, generated here and handed to the server through
+# Parameter Store rather than baked into user data (which any process on the
+# instance can read from the metadata endpoint).
+resource "random_password" "mailbox" {
+  for_each = var.mailboxes
+
+  length           = 20
+  min_upper        = 2
+  min_lower        = 2
+  min_numeric      = 2
+  min_special      = 2
+  override_special = "!#$%&*()-_=+"
+}
+
+resource "aws_ssm_parameter" "mailbox" {
+  for_each = var.mailboxes
+
+  name  = "/${var.domain_name}/mail/${each.key}"
+  type  = "SecureString"
+  value = random_password.mailbox[each.key].result
+}
+
+resource "aws_ssm_parameter" "smtp_password" {
+  name  = "/${var.domain_name}/mail/_relay_password"
+  type  = "SecureString"
+  value = aws_iam_access_key.smtp.ses_smtp_password_v4
+}
+
+# ---------- The server ----------
+
+data "aws_ami" "debian" {
+  most_recent = true
+  owners      = ["136693071363"] # Debian
+
+  filter {
+    name   = "name"
+    values = ["debian-12-arm64-*"]
+  }
+}
+
+# ---------- Network ----------
+
+# This account has no default VPC, and a mail server wants a stable, minimal
+# network anyway: one public subnet, one route to the internet, nothing else.
+resource "aws_vpc" "mail" {
+  cidr_block           = "10.20.0.0/16"
+  enable_dns_support   = true
+  enable_dns_hostnames = true
+
+  tags = { Name = "${var.domain_name}-mail" }
+}
+
+resource "aws_internet_gateway" "mail" {
+  vpc_id = aws_vpc.mail.id
+
+  tags = { Name = "${var.domain_name}-mail" }
+}
+
+resource "aws_subnet" "mail" {
+  vpc_id                  = aws_vpc.mail.id
+  cidr_block              = "10.20.1.0/24"
+  availability_zone       = data.aws_availability_zones.available.names[0]
+  map_public_ip_on_launch = true
+
+  tags = { Name = "${var.domain_name}-mail" }
+}
+
+resource "aws_route_table" "mail" {
+  vpc_id = aws_vpc.mail.id
+
+  route {
+    cidr_block = "0.0.0.0/0"
+    gateway_id = aws_internet_gateway.mail.id
+  }
+
+  tags = { Name = "${var.domain_name}-mail" }
+}
+
+resource "aws_route_table_association" "mail" {
+  subnet_id      = aws_subnet.mail.id
+  route_table_id = aws_route_table.mail.id
+}
+
+resource "aws_security_group" "mail" {
+  name_prefix = "${replace(var.domain_name, ".", "-")}-mail-"
+  description = "Mail server: SMTP in, IMAP and submission for clients, HTTP for certificate renewal"
+  vpc_id      = aws_vpc.mail.id
+}
+
+# Port 25 is how other mail servers deliver to you, so it has to be open to
+# the whole internet. 587 is how your own people send. 993 is how their mail
+# clients read. 80 is only used by Let's Encrypt renewals. 465 (implicit TLS
+# submission) is deliberately not opened: 587 is the documented submission
+# port, and two ports for one job is surface without benefit.
+resource "aws_vpc_security_group_ingress_rule" "mail" {
+  for_each = {
+    smtp       = { port = 25, note = "inbound mail from other servers" }
+    http       = { port = 80, note = "Let's Encrypt renewal" }
+    submission = { port = 587, note = "your people sending (STARTTLS)" }
+    imaps      = { port = 993, note = "your people reading" }
+  }
+
+  security_group_id = aws_security_group.mail.id
+  description       = each.value.note
+  cidr_ipv4         = "0.0.0.0/0"
+  from_port         = each.value.port
+  to_port           = each.value.port
+  ip_protocol       = "tcp"
+}
+
+resource "aws_vpc_security_group_egress_rule" "all" {
+  security_group_id = aws_security_group.mail.id
+  description       = "outbound: SES relay, package updates, Let's Encrypt"
+  cidr_ipv4         = "0.0.0.0/0"
+  ip_protocol       = "-1"
+}
+
+# Shell access is through SSM Session Manager, so there is no SSH port open
+# and no key to lose.
+resource "aws_iam_role" "instance" {
+  name_prefix = "${replace(var.domain_name, ".", "-")}-mail-"
+
+  assume_role_policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = [{
+      Effect    = "Allow"
+      Action    = "sts:AssumeRole"
+      Principal = { Service = "ec2.amazonaws.com" }
+    }]
+  })
+}
+
+resource "aws_iam_role_policy_attachment" "ssm" {
+  role       = aws_iam_role.instance.name
+  policy_arn = "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
+}
+
+# Read only this domain's own secrets, nothing else in Parameter Store.
+data "aws_iam_policy_document" "instance" {
+  statement {
+    actions   = ["ssm:GetParameter", "ssm:GetParametersByPath"]
+    resources = ["arn:aws:ssm:${data.aws_region.current.region}:*:parameter/${var.domain_name}/mail/*"]
+  }
+
+  statement {
+    # The CloudWatch agent publishes disk and memory metrics; there is no
+    # resource-level scoping available for PutMetricData.
+    actions   = ["cloudwatch:PutMetricData"]
+    resources = ["*"]
+  }
+
+  statement {
+    actions   = ["sns:Publish"]
+    resources = [aws_sns_topic.alerts.arn]
+  }
+}
+
+resource "aws_iam_role_policy" "instance" {
+  name   = "read-mail-secrets"
+  role   = aws_iam_role.instance.id
+  policy = data.aws_iam_policy_document.instance.json
+}
+
+resource "aws_iam_instance_profile" "instance" {
+  name_prefix = "${replace(var.domain_name, ".", "-")}-mail-"
+  role        = aws_iam_role.instance.name
+}
+
+# Mail lives on its own disk. Rebuild or resize the server and the mail is
+# untouched, because it was never on the root volume.
+resource "aws_ebs_volume" "mail" {
+  # Pinned to the same AZ as the subnet, NOT read off the instance. On
+  # instance replacement the instance's AZ becomes "known after apply",
+  # which forces replacement of this volume -- and availability_zone is
+  # ForceNew, so that is data loss. Do not "simplify" this line.
+  availability_zone = data.aws_availability_zones.available.names[0]
+  size              = var.mail_volume_gb
+  type              = "gp3"
+  encrypted         = true
+
+  tags = {
+    Name   = "${var.domain_name}-mail-data"
+    Backup = local.snapshot_tag
+  }
+
+  lifecycle {
+    # Flipping enable_mailserver to false must not be able to delete
+    # everyone's mail. Removing this volume on purpose means
+    # `terraform state rm` first -- see the teardown runbook.
+    prevent_destroy = true
+  }
+}
+
+resource "aws_volume_attachment" "mail" {
+  device_name = "/dev/xvdf"
+  volume_id   = aws_ebs_volume.mail.id
+  instance_id = aws_instance.mail.id
+}
+
+resource "aws_instance" "mail" {
+  ami                    = data.aws_ami.debian.id
+  instance_type          = var.instance_type
+  iam_instance_profile   = aws_iam_instance_profile.instance.name
+  vpc_security_group_ids = [aws_security_group.mail.id]
+  subnet_id              = aws_subnet.mail.id
+
+  root_block_device {
+    volume_size = 20
+    volume_type = "gp3"
+    encrypted   = true
+  }
+
+  user_data_replace_on_change = true
+  user_data = templatefile("${path.module}/templates/setup.sh.tftpl", {
+    domain           = var.domain_name
+    fqdn             = local.fqdn
+    region           = data.aws_region.current.region
+    relay_user       = aws_iam_access_key.smtp.id
+    alert_email      = var.alert_email
+    param_prefix     = "/${var.domain_name}/mail"
+    postmaster       = "postmaster@${var.domain_name}"
+    admin_address    = "${var.admin_mailbox}@${var.domain_name}"
+    mail_device      = "/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_${replace(aws_ebs_volume.mail.id, "-", "")}"
+    alerts_topic_arn = aws_sns_topic.alerts.arn
+  })
+
+  # Containers must not be able to reach instance credentials: one hop is
+  # the host itself, so a container's request is dropped. Without this,
+  # anything running here can read every mailbox password from SSM.
+  metadata_options {
+    http_tokens                 = "required"
+    http_endpoint               = "enabled"
+    http_put_response_hop_limit = 1
+  }
+
+  # T-series defaults to "unlimited", which bills for sustained bursts.
+  # A spam flood would quietly make this an expensive instance.
+  credit_specification {
+    cpu_credits = "standard"
+  }
+
+  lifecycle {
+    # data.aws_ami.debian is most_recent, so a new Debian release would
+    # otherwise replace this instance during an unrelated apply. OS
+    # upgrades are deliberate: terraform apply -replace=...
+    ignore_changes = [ami]
+  }
+
+  tags = { Name = "${var.domain_name}-mail" }
+}
+
+# A fixed address, so the MX record and the reverse-DNS record stay valid
+# across reboots and rebuilds.
+resource "aws_eip" "mail" {
+  instance = aws_instance.mail.id
+  domain   = "vpc"
+
+  tags = { Name = "${var.domain_name}-mail" }
+}
+
+# ---------- DNS ----------
+
+resource "aws_route53_record" "mail_a" {
+  zone_id = var.zone_id
+  name    = local.fqdn
+  type    = "A"
+  ttl     = 300
+  records = [aws_eip.mail.public_ip]
+}
+
+# Where the world delivers mail for this domain.
+resource "aws_route53_record" "mx" {
+  zone_id = var.zone_id
+  name    = var.domain_name
+  type    = "MX"
+  ttl     = 600
+  records = ["10 ${local.fqdn}"]
+}
+
+# SES is the only sender. The instance's own IP is deliberately absent:
+# AWS blocks outbound 25 so it never sends, and authorising it here
+# would pre-approve spoofing if that block were ever lifted.
+resource "aws_route53_record" "spf" {
+  zone_id = var.zone_id
+  name    = var.domain_name
+  type    = "TXT"
+  ttl     = 600
+  records = ["v=spf1 include:amazonses.com -all"]
+}
+
+# Start at p=none so you can watch the reports without mail being rejected
+# while DNS settles. Tighten to quarantine, then reject, once it is clean.
+resource "aws_route53_record" "dmarc" {
+  zone_id = var.zone_id
+  name    = "_dmarc.${var.domain_name}"
+  type    = "TXT"
+  ttl     = 600
+  records = ["v=DMARC1; p=none; rua=mailto:${var.admin_mailbox}@${var.domain_name}"]
+}
+
+# ---------- Backups ----------
+
+# DLM needs a service role. The console creates this silently; in
+# Terraform it is explicit. The AWS managed policy already covers
+# kms:CreateGrant for the encrypted volume.
+resource "aws_iam_role" "dlm" {
+  name_prefix = "${replace(var.domain_name, ".", "-")}-dlm-"
+
+  assume_role_policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = [{
+      Effect    = "Allow"
+      Action    = "sts:AssumeRole"
+      Principal = { Service = "dlm.amazonaws.com" }
+    }]
+  })
+}
+
+resource "aws_iam_role_policy_attachment" "dlm" {
+  role       = aws_iam_role.dlm.name
+  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSDataLifecycleManagerServiceRole"
+}
+
+# Every 6 hours rather than nightly. Mail a sender has already been told
+# we accepted is mail the sender has discarded -- between snapshots this
+# disk is the only copy in existence. Snapshots are block-incremental, so
+# four a day costs little more than one.
+resource "aws_dlm_lifecycle_policy" "mail" {
+  # AWS only accepts [0-9A-Za-z _-] here, so the domain's dots are stripped --
+  # local.snapshot_tag already does exactly that for the snapshot tags.
+  description        = "${local.snapshot_tag} mail volume"
+  execution_role_arn = aws_iam_role.dlm.arn
+  state              = "ENABLED"
+
+  policy_details {
+    resource_types = ["VOLUME"]
+
+    target_tags = {
+      Backup = local.snapshot_tag
+    }
+
+    schedule {
+      name = "6-hourly"
+
+      create_rule {
+        interval      = 6
+        interval_unit = "HOURS"
+        times         = ["00:00"]
+      }
+
+      retain_rule {
+        count = 28 # 7 days
+      }
+
+      # Tags are what the teardown cleanup matches on. Without them the
+      # snapshots are unfindable and bill forever.
+      tags_to_add = {
+        Name   = "${var.domain_name}-mail-data"
+        Backup = local.snapshot_tag
+      }
+
+      copy_tags = true
+    }
+  }
+}
diff --git a/infra/modules/mailserver/monitoring.tf b/infra/modules/mailserver/monitoring.tf
new file mode 100644
index 0000000..f15743b
--- /dev/null
+++ b/infra/modules/mailserver/monitoring.tf
@@ -0,0 +1,136 @@
+# Alarms reach a human through SNS. AWS Budgets emails directly and is
+# configured separately in setup/ -- two independent paths, so a broken
+# SNS subscription does not leave the owner blind.
+resource "aws_sns_topic" "alerts" {
+  name = "${replace(var.domain_name, ".", "-")}-mail-alerts"
+}
+
+resource "aws_sns_topic_subscription" "alerts" {
+  topic_arn = aws_sns_topic.alerts.arn
+  protocol  = "email"
+  endpoint  = var.alert_email
+}
+
+locals {
+  alarm_actions = [aws_sns_topic.alerts.arn]
+}
+
+# The only check that tests the outcome from outside the box: can the
+# internet actually deliver mail here? Catches a dead Postfix, a broken
+# security group and a crash-looping container alike. Free for up to 50
+# checks against AWS endpoints in this account.
+resource "aws_route53_health_check" "smtp" {
+  ip_address        = aws_eip.mail.public_ip
+  port              = 25
+  type              = "TCP"
+  request_interval  = 30
+  failure_threshold = 3
+
+  tags = { Name = "${var.domain_name}-smtp" }
+}
+
+resource "aws_cloudwatch_metric_alarm" "smtp_down" {
+  alarm_name          = "${var.domain_name}-smtp-unreachable"
+  alarm_description   = "Port 25 is not answering. Mail is being deferred by senders."
+  namespace           = "AWS/Route53"
+  metric_name         = "HealthCheckStatus"
+  dimensions          = { HealthCheckId = aws_route53_health_check.smtp.id }
+  statistic           = "Minimum"
+  period              = 60
+  evaluation_periods  = 2
+  threshold           = 1
+  comparison_operator = "LessThanThreshold"
+  alarm_actions       = local.alarm_actions
+}
+
+resource "aws_cloudwatch_metric_alarm" "host" {
+  alarm_name          = "${var.domain_name}-mail-host-check"
+  alarm_description   = "EC2 status check failing. The host or the OS is wedged."
+  namespace           = "AWS/EC2"
+  metric_name         = "StatusCheckFailed"
+  dimensions          = { InstanceId = aws_instance.mail.id }
+  statistic           = "Maximum"
+  period              = 60
+  evaluation_periods  = 2
+  threshold           = 0
+  comparison_operator = "GreaterThanThreshold"
+  alarm_actions       = local.alarm_actions
+}
+
+resource "aws_cloudwatch_metric_alarm" "disk" {
+  alarm_name        = "${var.domain_name}-mail-disk-full"
+  alarm_description = "Mail volume over 80% used."
+  namespace         = "CWAgent"
+  metric_name       = "disk_used_percent"
+  dimensions = {
+    InstanceId = aws_instance.mail.id
+    path       = "/var/mail-data"
+    fstype     = "ext4"
+  }
+  statistic           = "Average"
+  period              = 300
+  evaluation_periods  = 2
+  threshold           = 80
+  comparison_operator = "GreaterThanThreshold"
+  alarm_actions       = local.alarm_actions
+}
+
+resource "aws_cloudwatch_metric_alarm" "memory" {
+  alarm_name          = "${var.domain_name}-mail-memory"
+  alarm_description   = "Under 15% memory free. Usually Rspamd growing; if this fires twice in 30 days, move to t4g.medium."
+  namespace           = "CWAgent"
+  metric_name         = "mem_available_percent"
+  dimensions          = { InstanceId = aws_instance.mail.id }
+  statistic           = "Average"
+  period              = 300
+  evaluation_periods  = 2
+  threshold           = 15
+  comparison_operator = "LessThanThreshold"
+  alarm_actions       = local.alarm_actions
+}
+
+# treat_missing_data is the whole point here: a DLM policy in an errored
+# state publishes NO metrics at all, so alarming on failures would stay
+# green in exactly the case that matters. Alarm on the absence of success.
+resource "aws_cloudwatch_metric_alarm" "snapshots" {
+  alarm_name          = "${var.domain_name}-mail-snapshots-stopped"
+  alarm_description   = "No snapshot completed in 24h. Backups have silently stopped."
+  namespace           = "AWS/EBS"
+  metric_name         = "SnapshotsCreateCompleted"
+  dimensions          = { DLMPolicyId = aws_dlm_lifecycle_policy.mail.id }
+  statistic           = "Sum"
+  period              = 86400
+  evaluation_periods  = 1
+  threshold           = 1
+  comparison_operator = "LessThanThreshold"
+  treat_missing_data  = "breaching"
+  alarm_actions       = local.alarm_actions
+}
+
+resource "aws_cloudwatch_metric_alarm" "bounces" {
+  alarm_name          = "${var.domain_name}-ses-bounce-rate"
+  alarm_description   = "SES bounce rate above 5%. Sustained, AWS suspends sending."
+  namespace           = "AWS/SES"
+  metric_name         = "Reputation.BounceRate"
+  statistic           = "Average"
+  period              = 3600
+  evaluation_periods  = 1
+  threshold           = 0.05
+  comparison_operator = "GreaterThanThreshold"
+  treat_missing_data  = "notBreaching"
+  alarm_actions       = local.alarm_actions
+}
+
+resource "aws_cloudwatch_metric_alarm" "cpu_credits" {
+  alarm_name          = "${var.domain_name}-mail-cpu-credits"
+  alarm_description   = "CPU credit balance low. Sustained load will throttle the mail server."
+  namespace           = "AWS/EC2"
+  metric_name         = "CPUCreditBalance"
+  dimensions          = { InstanceId = aws_instance.mail.id }
+  statistic           = "Minimum"
+  period              = 300
+  evaluation_periods  = 2
+  threshold           = 30
+  comparison_operator = "LessThanThreshold"
+  alarm_actions       = local.alarm_actions
+}
diff --git a/infra/modules/mailserver/outputs.tf b/infra/modules/mailserver/outputs.tf
