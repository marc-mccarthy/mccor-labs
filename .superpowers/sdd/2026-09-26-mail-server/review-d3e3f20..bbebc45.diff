+# Your own mail server, on your own instance, holding your own mailboxes.
+#
+# Receiving is direct: the internet delivers to this box on port 25, it runs
+# the spam filter, and it stores mail on a disk you own. Nobody else holds
+# the mailboxes.
+#
+# Sending goes out through SES on port 587 instead of straight to the world on
+# port 25. Two reasons, both practical: AWS blocks outbound 25 on every EC2
+# instance until you petition them to unblock it, and a brand-new IP address
+# has no sending reputation, so Gmail and Outlook treat its mail as suspicious.
+# Relaying through SES avoids both. SES is in your own account -- this is not a
+# third party holding your mail, only the last hop that hands it over.
+
+terraform {
+  required_providers {
+    aws = {
+      source  = "hashicorp/aws"
+      version = ">= 6.0"
+    }
+    random = {
+      source  = "hashicorp/random"
+      version = ">= 3.6"
+    }
+  }
+}
+
+data "aws_region" "current" {}
+data "aws_availability_zones" "available" {
+  state = "available"
+}
+
+locals {
+  fqdn      = "${var.hostname}.${var.domain_name}"
+  addresses = { for k, v in var.mailboxes : k => "${k}@${var.domain_name}" }
+}
+
+# ---------- Sending: SES as the outbound relay ----------
+
+resource "aws_ses_domain_identity" "main" {
+  domain = var.domain_name
+}
+
+resource "aws_ses_domain_dkim" "main" {
+  domain = aws_ses_domain_identity.main.domain
+}
+
+# Lets receiving servers verify the signature SES puts on your outgoing mail.
+resource "aws_route53_record" "dkim" {
+  count = 3
+
+  zone_id = var.zone_id
+  name    = "${aws_ses_domain_dkim.main.dkim_tokens[count.index]}._domainkey.${var.domain_name}"
+  type    = "CNAME"
+  ttl     = 600
+  records = ["${aws_ses_domain_dkim.main.dkim_tokens[count.index]}.dkim.amazonses.com"]
+}
+
+# An IAM user whose only power is handing mail to SES. Its access key doubles
+# as an SMTP password through a documented conversion, which is why the server
+# can authenticate to SES with plain SMTP.
+resource "aws_iam_user" "smtp" {
+  name = "${replace(var.domain_name, ".", "-")}-mail-relay"
+}
+
+data "aws_iam_policy_document" "smtp" {
+  statement {
+    actions   = ["ses:SendRawEmail"]
+    resources = ["*"]
+  }
+}
+
+resource "aws_iam_user_policy" "smtp" {
+  name   = "send-mail"
+  user   = aws_iam_user.smtp.name
+  policy = data.aws_iam_policy_document.smtp.json
+}
+
+resource "aws_iam_access_key" "smtp" {
+  user = aws_iam_user.smtp.name
+}
+
+# ---------- The mailboxes themselves ----------
+
+# One password per person, generated here and handed to the server through
+# Parameter Store rather than baked into user data (which any process on the
+# instance can read from the metadata endpoint).
+resource "random_password" "mailbox" {
+  for_each = var.mailboxes
+
+  length           = 20
+  min_upper        = 2
+  min_lower        = 2
+  min_numeric      = 2
+  min_special      = 2
+  override_special = "!#$%&*()-_=+"
+}
+
+resource "aws_ssm_parameter" "mailbox" {
+  for_each = var.mailboxes
+
+  name  = "/${var.domain_name}/mail/${each.key}"
+  type  = "SecureString"
+  value = random_password.mailbox[each.key].result
+}
+
+resource "aws_ssm_parameter" "smtp_password" {
+  name  = "/${var.domain_name}/mail/_relay_password"
+  type  = "SecureString"
+  value = aws_iam_access_key.smtp.ses_smtp_password_v4
+}
+
+# ---------- The server ----------
+
+data "aws_ami" "debian" {
+  most_recent = true
+  owners      = ["136693071363"] # Debian
+
+  filter {
+    name   = "name"
+    values = ["debian-12-arm64-*"]
+  }
+}
+
+# ---------- Network ----------
+
+# This account has no default VPC, and a mail server wants a stable, minimal
+# network anyway: one public subnet, one route to the internet, nothing else.
+resource "aws_vpc" "mail" {
+  cidr_block           = "10.20.0.0/16"
+  enable_dns_support   = true
+  enable_dns_hostnames = true
+
+  tags = { Name = "${var.domain_name}-mail" }
+}
+
+resource "aws_internet_gateway" "mail" {
+  vpc_id = aws_vpc.mail.id
+
+  tags = { Name = "${var.domain_name}-mail" }
+}
+
+resource "aws_subnet" "mail" {
+  vpc_id                  = aws_vpc.mail.id
+  cidr_block              = "10.20.1.0/24"
+  availability_zone       = data.aws_availability_zones.available.names[0]
+  map_public_ip_on_launch = true
+
+  tags = { Name = "${var.domain_name}-mail" }
+}
+
+resource "aws_route_table" "mail" {
+  vpc_id = aws_vpc.mail.id
+
+  route {
+    cidr_block = "0.0.0.0/0"
+    gateway_id = aws_internet_gateway.mail.id
+  }
+
+  tags = { Name = "${var.domain_name}-mail" }
+}
+
+resource "aws_route_table_association" "mail" {
+  subnet_id      = aws_subnet.mail.id
+  route_table_id = aws_route_table.mail.id
+}
+
+resource "aws_security_group" "mail" {
+  name_prefix = "${replace(var.domain_name, ".", "-")}-mail-"
+  description = "Mail server: SMTP in, IMAP and submission for clients, HTTP for certificate renewal"
+  vpc_id      = aws_vpc.mail.id
+}
+
+# Port 25 is how other mail servers deliver to you, so it has to be open to
+# the whole internet. 587 and 465 are how your own people send. 993 is how
+# their mail clients read. 80 is only used by Let's Encrypt renewals.
+resource "aws_vpc_security_group_ingress_rule" "mail" {
+  for_each = {
+    smtp       = { port = 25, note = "inbound mail from other servers" }
+    http       = { port = 80, note = "Let's Encrypt renewal" }
+    submission = { port = 587, note = "your people sending (STARTTLS)" }
+    smtps      = { port = 465, note = "your people sending (implicit TLS)" }
+    imaps      = { port = 993, note = "your people reading" }
+  }
+
+  security_group_id = aws_security_group.mail.id
+  description       = each.value.note
+  cidr_ipv4         = "0.0.0.0/0"
+  from_port         = each.value.port
+  to_port           = each.value.port
+  ip_protocol       = "tcp"
+}
+
+resource "aws_vpc_security_group_egress_rule" "all" {
+  security_group_id = aws_security_group.mail.id
+  description       = "outbound: SES relay, package updates, Let's Encrypt"
+  cidr_ipv4         = "0.0.0.0/0"
+  ip_protocol       = "-1"
+}
+
+# Shell access is through SSM Session Manager, so there is no SSH port open
+# and no key to lose.
+resource "aws_iam_role" "instance" {
+  name_prefix = "${replace(var.domain_name, ".", "-")}-mail-"
+
+  assume_role_policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = [{
+      Effect    = "Allow"
+      Action    = "sts:AssumeRole"
+      Principal = { Service = "ec2.amazonaws.com" }
+    }]
+  })
+}
+
+resource "aws_iam_role_policy_attachment" "ssm" {
+  role       = aws_iam_role.instance.name
+  policy_arn = "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
+}
+
+# Read only this domain's own secrets, nothing else in Parameter Store.
+data "aws_iam_policy_document" "instance" {
+  statement {
+    actions   = ["ssm:GetParameter", "ssm:GetParametersByPath"]
+    resources = ["arn:aws:ssm:${data.aws_region.current.region}:*:parameter/${var.domain_name}/mail/*"]
+  }
+}
+
+resource "aws_iam_role_policy" "instance" {
+  name   = "read-mail-secrets"
+  role   = aws_iam_role.instance.id
+  policy = data.aws_iam_policy_document.instance.json
+}
+
+resource "aws_iam_instance_profile" "instance" {
+  name_prefix = "${replace(var.domain_name, ".", "-")}-mail-"
+  role        = aws_iam_role.instance.name
+}
+
+# Mail lives on its own disk. Rebuild or resize the server and the mail is
+# untouched, because it was never on the root volume.
+resource "aws_ebs_volume" "mail" {
+  availability_zone = aws_instance.mail.availability_zone
+  size              = var.mail_volume_gb
+  type              = "gp3"
+  encrypted         = true
+
+  tags = { Name = "${var.domain_name}-mail-data" }
+}
+
+resource "aws_volume_attachment" "mail" {
+  device_name = "/dev/xvdf"
+  volume_id   = aws_ebs_volume.mail.id
+  instance_id = aws_instance.mail.id
+}
+
+resource "aws_instance" "mail" {
+  ami                    = data.aws_ami.debian.id
+  instance_type          = var.instance_type
+  iam_instance_profile   = aws_iam_instance_profile.instance.name
+  vpc_security_group_ids = [aws_security_group.mail.id]
+  subnet_id              = aws_subnet.mail.id
+
+  root_block_device {
+    volume_size = 20
+    volume_type = "gp3"
+    encrypted   = true
+  }
+
+  user_data_replace_on_change = true
+  user_data = templatefile("${path.module}/templates/setup.sh.tftpl", {
+    domain        = var.domain_name
+    fqdn          = local.fqdn
+    region        = data.aws_region.current.region
+    relay_user    = aws_iam_access_key.smtp.id
+    alert_email   = var.alert_email
+    mailbox_names = join(" ", sort(keys(var.mailboxes)))
+    param_prefix  = "/${var.domain_name}/mail"
+    postmaster    = "postmaster@${var.domain_name}"
+    admin_address = "${var.admin_mailbox}@${var.domain_name}"
+  })
+
+  # Containers must not be able to reach instance credentials: one hop is
+  # the host itself, so a container's request is dropped. Without this,
+  # anything running here can read every mailbox password from SSM.
+  metadata_options {
+    http_tokens                 = "required"
+    http_endpoint               = "enabled"
+    http_put_response_hop_limit = 1
+  }
+
+  # T-series defaults to "unlimited", which bills for sustained bursts.
+  # A spam flood would quietly make this an expensive instance.
+  credit_specification {
+    cpu_credits = "standard"
+  }
+
+  lifecycle {
+    # data.aws_ami.debian is most_recent, so a new Debian release would
+    # otherwise replace this instance during an unrelated apply. OS
+    # upgrades are deliberate: terraform apply -replace=...
+    ignore_changes = [ami]
+  }
+
+  tags = { Name = "${var.domain_name}-mail" }
+}
+
+# A fixed address, so the MX record and the reverse-DNS record stay valid
+# across reboots and rebuilds.
+resource "aws_eip" "mail" {
+  instance = aws_instance.mail.id
+  domain   = "vpc"
+
+  tags = { Name = "${var.domain_name}-mail" }
+}
+
+# ---------- DNS ----------
+
+resource "aws_route53_record" "mail_a" {
+  zone_id = var.zone_id
+  name    = local.fqdn
+  type    = "A"
+  ttl     = 300
+  records = [aws_eip.mail.public_ip]
+}
+
+# Where the world delivers mail for this domain.
+resource "aws_route53_record" "mx" {
+  zone_id = var.zone_id
+  name    = var.domain_name
+  type    = "MX"
+  ttl     = 600
+  records = ["10 ${local.fqdn}"]
+}
+
+# Who is allowed to send as this domain: SES, because that is the relay, and
+# the server's own address for anything that bypasses it.
+resource "aws_route53_record" "spf" {
+  zone_id = var.zone_id
+  name    = var.domain_name
+  type    = "TXT"
+  ttl     = 600
+  records = ["v=spf1 include:amazonses.com ip4:${aws_eip.mail.public_ip} -all"]
+}
+
+# Start at p=none so you can watch the reports without mail being rejected
+# while DNS settles. Tighten to quarantine, then reject, once it is clean.
+resource "aws_route53_record" "dmarc" {
+  zone_id = var.zone_id
+  name    = "_dmarc.${var.domain_name}"
+  type    = "TXT"
+  ttl     = 600
+  records = ["v=DMARC1; p=none; rua=mailto:${var.admin_mailbox}@${var.domain_name}"]
+}
+
+# Lets Apple Mail, Outlook and Thunderbird configure themselves from just an
+# address and password.
+resource "aws_route53_record" "autodiscover" {
+  zone_id = var.zone_id
+  name    = "autodiscover.${var.domain_name}"
+  type    = "CNAME"
+  ttl     = 600
+  records = [local.fqdn]
+}
+
+resource "aws_route53_record" "autoconfig" {
+  zone_id = var.zone_id
+  name    = "autoconfig.${var.domain_name}"
+  type    = "CNAME"
+  ttl     = 600
+  records = [local.fqdn]
+}
diff --git a/infra/settings.auto.tfvars.example b/infra/settings.auto.tfvars.example
new file mode 100644
index 0000000..877812b
--- /dev/null
+++ b/infra/settings.auto.tfvars.example
@@ -0,0 +1,70 @@
+# ---------------------------------------------------------------
+# Copy this to settings.auto.tfvars and fill in the blanks.
+#
+#   cp settings.auto.tfvars.example settings.auto.tfvars
+#
+# This file IS committed. settings.auto.tfvars is NOT -- it holds
+# your real domain, your email address and your team's names.
+#
+# Values left as "" below are the ones you must fill in. Terraform
+# refuses to run until they are set, rather than silently deploying
+# with a placeholder.
+# ---------------------------------------------------------------
+
+# ---------- Fill these in ----------
+
+# The domain you own. No "www", no "https://".
+domain_name = ""
+
+# Where AWS spending alerts and mail-server warnings are sent. Use an
+# address on a DIFFERENT provider -- if this server breaks, an alert
+# delivered to this server is an alert you never see.
+alert_email = ""
+
+# ---------- Safe defaults, change if you like ----------
+
+# Short name used in app resource names (the website, API, database).
+# 3-20 characters: lowercase letters, numbers, dashes. Can't contain
+# "aws", "amazon" or "cognito".
+project = "yourproject"
+
+# Email an alert if the month's AWS bill is forecast to pass this (USD).
+# The mail server costs ~$21/month, so 25 leaves room for a real
+# mistake to show up without nagging about normal operation.
+monthly_budget_usd = 25
+
+# ---------------------------------------------------------------
+# Your own mail server
+#
+# One EC2 instance holding your own mailboxes on a disk you own.
+# Flat cost -- adding people does not add to the bill.
+#
+# Turn this on only AFTER the name servers from `deploy.sh setup` are
+# live at your registrar. The server's TLS certificate is issued by
+# reading DNS, which cannot work before the zone is authoritative.
+# ---------------------------------------------------------------
+
+enable_mailserver = false
+
+# Who gets a mailbox. Local part => display name, so
+# "jdoe" becomes jdoe@<domain_name>, shown as "Jane Doe".
+mailboxes = {
+  # jdoe = "Jane Doe"
+}
+
+# Which mailbox receives postmaster@, abuse@ and the DMARC reports.
+# Name one deliberately -- left unset it would fall to whoever sorts
+# first alphabetically, and would move when you hire someone.
+admin_mailbox = ""
+
+# ---------------------------------------------------------------
+# Mail forwarding (alternative to the mail server above -- you cannot
+# have both, they each need the domain's MX record).
+#
+# Addresses that forward into an inbox you already own. No per-user
+# cost and nothing to sign into.
+# ---------------------------------------------------------------
+
+# enable_email    = true
+# mail_forward_to = ""                     # defaults to alert_email
+# mail_recipients = ["hello", "support"]   # [] accepts the whole domain
diff --git a/infra/setup/main.tf b/infra/setup/main.tf
new file mode 100644
index 0000000..534c7a9
--- /dev/null
+++ b/infra/setup/main.tf
@@ -0,0 +1,316 @@
+# One-time setup, run with `./deploy.sh setup`. Creates the things every
+# environment shares:
+#   - the S3 bucket that stores Terraform state
+#   - the Route 53 zone for your domain (the only fixed cost: $0.50/month)
+#   - a monthly AWS spending alert (free)
+#   - ../backend.hcl, which tells the main configuration where its state lives
+#
+# Reads the same ../settings.auto.tfvars as everything else. Its own state is
+# kept on your machine in terraform.tfstate (git-ignored); keep a backup.
+
+terraform {
+  required_version = "~> 1.16"
+
+  required_providers {
+    aws = {
+      source  = "hashicorp/aws"
+      version = "~> 6.58"
+    }
+    local = {
+      source  = "hashicorp/local"
+      version = "~> 2.9"
+    }
+    archive = {
+      source  = "hashicorp/archive"
+      version = "~> 2.8"
+    }
+    random = {
+      source  = "hashicorp/random"
+      version = "~> 3.6"
+    }
+  }
+}
+
+provider "aws" {
+  region = "us-east-1"
+
+  default_tags {
+    tags = {
+      Project   = var.project
+      ManagedBy = "terraform"
+    }
+  }
+}
+
+variable "project" {
+  type = string
+
+  validation {
+    condition     = can(regex("^[a-z][a-z0-9-]{1,18}[a-z0-9]$", var.project)) && !can(regex("aws|amazon|cognito", var.project))
+    error_message = "Use 3-20 lowercase letters, numbers or dashes, starting with a letter. Can't contain aws, amazon or cognito."
+  }
+}
+
+variable "domain_name" {
+  type = string
+
+  validation {
+    condition     = length(var.domain_name) > 0
+    error_message = "domain_name is blank. Copy settings.auto.tfvars.example and fill it in."
+  }
+}
+
+variable "alert_email" {
+  # Use an address on a different provider: an alert about this mail server
+  # delivered to this mail server is an alert nobody sees.
+  type = string
+
+  validation {
+    condition     = length(var.alert_email) > 0
+    error_message = "alert_email is blank. Copy settings.auto.tfvars.example and fill it in."
+  }
+}
+
+variable "monthly_budget_usd" {
+  type    = number
+  default = 5
+}
+
+variable "enable_email" {
+  description = "Turn on mail forwarding for the domain. Leave false until your registrar points at this zone's name servers, otherwise SES cannot verify the domain."
+  type        = bool
+  default     = false
+}
+
+variable "mail_forward_to" {
+  description = "Inbox every address forwards to. Defaults to alert_email."
+  type        = string
+  default     = null
+}
+
+variable "mail_recipients" {
+  description = "Local parts that accept mail. Empty list accepts the whole domain."
+  type        = list(string)
+  default     = ["hello", "support"]
+}
+
+variable "enable_mailserver" {
+  description = "Run your own mail server on EC2, holding your own mailboxes. Leave false until your registrar points at this zone's name servers, otherwise the TLS certificate cannot be issued."
+  type        = bool
+  default     = false
+
+  validation {
+    condition     = !(var.enable_mailserver && var.enable_email)
+    error_message = "enable_mailserver and enable_email cannot both be true: each needs the domain's MX record. Pick one."
+  }
+}
+
+variable "mailboxes" {
+  description = "Mailbox local part => display name. marcm = \"Marc M\" creates marcm@<domain_name>."
+  type        = map(string)
+  default     = {}
+
+  validation {
+    condition     = !var.enable_mailserver || length(var.mailboxes) > 0
+    error_message = "enable_mailserver is true but mailboxes is empty. A mail server with no mailboxes accepts mail it cannot deliver."
+  }
+}
+
+variable "admin_mailbox" {
+  description = "Which mailbox receives postmaster@, abuse@ and DMARC reports. Must be a key in mailboxes."
+  type        = string
+  default     = ""
+
+  validation {
+    condition     = !var.enable_mailserver || contains(keys(var.mailboxes), var.admin_mailbox)
+    error_message = "admin_mailbox must name one of the mailboxes. Left to chance it falls to whoever sorts first alphabetically, and moves when you hire someone."
+  }
+}
+
+variable "force_destroy" {
+  description = "Set true only when removing everything for good. While false, Terraform refuses to delete a state bucket or DNS zone that still has contents."
+  type        = bool
+  default     = false
+}
+
+# ---------- Terraform state bucket ----------
+
+# Named from domain_name, which you already own, so the name is globally
+# unique without leaking the account id: mccorlabs.com -> mccorlabs-com-tfstate.
+locals {
+  state_bucket = "${replace(var.domain_name, ".", "-")}-tfstate"
+}
+
+resource "aws_s3_bucket" "state" {
+  bucket        = local.state_bucket
+  force_destroy = var.force_destroy
+}
+
+# Versioning lets you recover a previous state file if something goes wrong.
+resource "aws_s3_bucket_versioning" "state" {
+  bucket = aws_s3_bucket.state.id
+
+  versioning_configuration {
+    status = "Enabled"
+  }
+}
+
+resource "aws_s3_bucket_public_access_block" "state" {
+  bucket                  = aws_s3_bucket.state.id
+  block_public_acls       = true
+  block_public_policy     = true
+  ignore_public_acls      = true
+  restrict_public_buckets = true
+}
+
+# Delete old state versions after 90 days so storage stays near $0.
+resource "aws_s3_bucket_lifecycle_configuration" "state" {
+  bucket = aws_s3_bucket.state.id
+
+  rule {
+    id     = "expire-old-state-versions"
+    status = "Enabled"
+
+    filter {}
+
+    noncurrent_version_expiration {
+      noncurrent_days = 90
+    }
+  }
+}
+
+# ---------- DNS zone for your domain ----------
+
+# After this is created, put its four name servers into your registrar
+# (Namecheap: Domain List > Manage > Nameservers > Custom DNS).
+resource "aws_route53_zone" "main" {
+  name          = var.domain_name
+  comment       = "Managed by Terraform (infra/setup)"
+  force_destroy = var.force_destroy
+}
+
+# ---------- Mail DNS ----------
+# Mail records are not written here. Whichever mail option is enabled below
+# owns them: modules/mailserver for your own server, modules/email for
+# forwarding. Keeping them in one module stops the two from fighting over
+# the domain's MX record.
+
+# ---------- Spending alert ----------
+
+# Budget monitoring and email alerts are free. Emails you if this month's
+# bill is forecast to pass 80% of the limit, and again if it passes 100%.
+resource "aws_budgets_budget" "monthly" {
+  name         = "${var.project}-monthly"
+  budget_type  = "COST"
+  limit_amount = tostring(var.monthly_budget_usd)
+  limit_unit   = "USD"
+  time_unit    = "MONTHLY"
+
+  notification {
+    comparison_operator        = "GREATER_THAN"
+    threshold                  = 80
+    threshold_type             = "PERCENTAGE"
+    notification_type          = "FORECASTED"
+    subscriber_email_addresses = [var.alert_email]
+  }
+
+  notification {
+    comparison_operator        = "GREATER_THAN"
+    threshold                  = 100
+    threshold_type             = "PERCENTAGE"
+    notification_type          = "ACTUAL"
+    subscriber_email_addresses = [var.alert_email]
+  }
+}
+
+# ---------- Mail forwarding (optional) ----------
+
+module "email" {
+  count  = var.enable_email ? 1 : 0
+  source = "../modules/email"
+
+  domain_name   = var.domain_name
+  zone_id       = aws_route53_zone.main.zone_id
+  forward_to    = coalesce(var.mail_forward_to, var.alert_email)
+  recipients    = var.mail_recipients
+  force_destroy = var.force_destroy
+}
+
+# ---------- Your own mail server (optional) ----------
+
+module "mailserver" {
+  count  = var.enable_mailserver ? 1 : 0
+  source = "../modules/mailserver"
+
+  domain_name   = var.domain_name
+  zone_id       = aws_route53_zone.main.zone_id
+  mailboxes     = var.mailboxes
+  admin_mailbox = var.admin_mailbox
+  alert_email   = var.alert_email
+}
+
+# ---------- Backend settings for the main configuration ----------
+
+resource "local_file" "backend" {
+  filename        = "${path.module}/../backend.hcl"
+  file_permission = "0644"
+  content         = <<-EOT
+    # Written by infra/setup. Commit this file.
+    bucket       = "${aws_s3_bucket.state.bucket}"
+    key          = "app/terraform.tfstate"
+    region       = "us-east-1"
+    use_lockfile = true
+    encrypt      = true
+  EOT
+}
+
+# ---------- Outputs ----------
+
+output "name_servers" {
+  description = "Enter these four in Namecheap as Custom DNS"
+  value       = aws_route53_zone.main.name_servers
+}
+
+output "state_bucket" {
+  value = aws_s3_bucket.state.bucket
+}
+
+output "forwarding_addresses" {
+  description = "Addresses that forward, once enable_email is true"
+  value       = var.enable_email ? module.email[0].addresses : []
+}
+
+output "forwards_to" {
+  value = var.enable_email ? module.email[0].forwards_to : null
+}
+
+output "mail_server" {
+  description = "Name your mail clients connect to"
+  value       = var.enable_mailserver ? module.mailserver[0].server_name : null
+}
+
+output "mail_addresses" {
+  value = var.enable_mailserver ? module.mailserver[0].addresses : []
+}
+
+output "mail_client_settings" {
+  description = "Settings for Apple Mail, Outlook, Thunderbird or the Gmail app"
+  value       = var.enable_mailserver ? module.mailserver[0].client_settings : null
+}
+
+output "mail_server_ip" {
+  description = "Fixed address of the server"
+  value       = var.enable_mailserver ? module.mailserver[0].public_ip : null
+}
+
+output "mail_instance_id" {
+  description = "Shell access: aws ssm start-session --target <this>"
+  value       = var.enable_mailserver ? module.mailserver[0].instance_id : null
+}
+
+# terraform output -json mailbox_passwords
+output "mailbox_passwords" {
+  description = "First-login password per mailbox"
+  value       = var.enable_mailserver ? module.mailserver[0].passwords : null
+  sensitive   = true
+}
