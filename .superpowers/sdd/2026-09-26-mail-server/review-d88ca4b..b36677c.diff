+# ---------- swap ----------
+# On the ROOT volume, deliberately: swap on the mail volume would be
+# captured by every snapshot and put swap I/O in the backup path. DMS
+# lists swap in its recommended setup; it turns a memory spike from an
+# OOM kill into a slow moment.
+if [ ! -f /swapfile ]; then
+  fallocate -l 2G /swapfile
+  chmod 600 /swapfile
+  mkswap /swapfile
+  echo "/swapfile none swap sw 0 0" >> /etc/fstab
+fi
+swapon -a || true
+
 # ---------- TLS certificate ----------
 # Standalone mode binds port 80, which is why the security group opens it.
 #
 # The ACME store lives on the persistent MAIL volume, not the root volume.
 # Let's Encrypt allows 5 certificates per name set per week; with the store
 # on the disposable root disk, a handful of instance replacements locks
 # issuance for over a day. On the mail volume a rebuilt instance finds its
 # existing certificate and issues nothing.
 #
